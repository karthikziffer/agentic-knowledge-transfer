// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String           @id @default(cuid())
  email           String           @unique
  passwordHash    String
  name            String?
  bio             String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  projects        Project[]
  globalVariables GlobalVariable[]
}

model GlobalVariable {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  key         String
  valueCipher String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, key])
}

model Project {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  skills      Skill[]
}

model Skill {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  name      String
  startUrl  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  prompts   Prompt[]
}

model Prompt {
  id        String   @id @default(cuid())
  skillId   String
  skill     Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)
  userId    String
  text      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  runs      Run[]
}

model Run {
  id                  String    @id @default(cuid())
  promptId            String
  prompt              Prompt    @relation(fields: [promptId], references: [id], onDelete: Cascade)
  userId              String
  promptText          String
  startUrl            String
  status              String
  error               String?
  report              Json      @default("[]")
  // Generated on demand from `report`'s screenshots/DOM diffs by a
  // LangGraph agent (src/server/flowSummary.ts) — a plain-language
  // narrative of the run, not part of the live run state machine.
  summary             Json?
  summaryModel        String?
  summaryGeneratedAt  DateTime?
  // Deterministic markdown rendering of `summary`, formatted for an AI
  // agent to read (src/server/skillsMd.ts) — requires `summary` to exist
  // first, no LLM call of its own.
  skillsMd            String?
  skillsMdGeneratedAt DateTime?
  // Set when this Run is a deterministic, locator-driven replay of another
  // Run (src/server/replay.ts) rather than a fresh manual recording — see
  // queue.ts's worker branch.
  sourceRunId         String?
  // SetNull (not Cascade/Restrict): a replay is its own independent Run
  // with its own report/artifacts — deleting the source it was replayed
  // from should neither delete the replay nor be blocked by it.
  sourceRun           Run?      @relation("RunReplays", fields: [sourceRunId], references: [id], onDelete: SetNull)
  replays             Run[]     @relation("RunReplays")
  // Set when this Run is one generated alternative for a single step of
  // sourceRunId (src/server/variation.ts) — clicks a different, real
  // element instead of what was actually recorded, then stops.
  // variantIndex is a display-order counter; variantLabel is the chosen
  // alternative's human-readable description, set at creation time from
  // the suggestion the user picked (see variantTargetLocator below).
  variantOfStepIndex  Int?
  variantIndex        Int?
  variantLabel        String?
  // The exact real element the alternative-suggestion pipeline
  // (src/server/alternativesAgent.ts) decided on for this variant — an
  // ElementLocator (src/server/types.ts), set once at creation time so
  // variantTask (src/server/variation.ts) just clicks it directly instead
  // of rediscovering or narrowing anything itself.
  variantTargetLocator Json?
  // Cached output of the alternative-suggestion pipeline
  // (src/server/alternativesAgent.ts), keyed by step index as a JSON
  // object — explicitly regenerated by the user, never auto-run, since it
  // launches a real browser and makes two LLM calls.
  alternativeSuggestions            Json?
  alternativeSuggestionsModel       String?
  alternativeSuggestionsGeneratedAt DateTime?
  // Set when this Run is a whole-site action-graph crawl for a skill
  // (src/server/actionGraph.ts) rather than a recording/replay/variant —
  // holds the Skill.id being crawled. The graph itself (pages/actions,
  // embeddings) lives in Memgraph, not here — this column only exists so
  // queue.ts's worker can tell which task function to dispatch to.
  crawlSkillId        String?
  // Set when this Run batch-executes every cataloged action in a skill's
  // action graph (src/server/actionGraph.ts's validateTask) to score how
  // many still work — holds the Skill.id being validated. Results
  // themselves are written back onto the Memgraph edges, not here.
  validateSkillId     String?
  // How many of the skill's cataloged actions to actually validate — set by
  // the user via the "Validate alternatives" count field (src/components/
  // SkillActionGraph.tsx). Null means "every cataloged action" (the
  // original, still-default behavior).
  validateCount       Int?
  // Set when this Run is a prompt-driven agent execution for a skill
  // (src/server/agent.ts's agentTask) rather than a recording/replay/crawl/
  // validation — holds the Skill.id whose action graph the agent searches
  // for known actions, and the natural-language instruction it's carrying
  // out. See queue.ts's worker dispatch.
  agentSkillId        String?
  agentPrompt         String?
  // Set alongside crawlSkillId/validateSkillId — the *source* run whose
  // "Create alternatives" tab this crawl/validation was launched from (not
  // this crawl/validate run's own id). Every PageState/ACTION node the
  // crawl writes in Memgraph is tagged with this, so each source run gets
  // its own independent action graph. See src/server/types.ts's RunRecord.
  graphRunId          String?
  createdAt           DateTime  @default(now())
  startedAt           DateTime?
  finishedAt          DateTime?
}
