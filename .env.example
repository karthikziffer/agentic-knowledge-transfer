# Copy this file to .env and fill in real values:
#   cp .env.example .env
#
# Docker Compose reads .env in this directory automatically, so this is the
# single place to configure both `docker compose up` and local `npm run dev`.

# Only used for local (non-Docker) dev — docker-compose.yml sets its own
# DATABASE_URL / REDIS_URL pointing at the postgres/redis services, ignoring
# these two.
DATABASE_URL="postgresql://skillbuilder:skillbuilder@localhost:5434/skillbuilder?schema=public"

# Points at the Redis started by `docker compose up` (host port 6381), used
# to queue Playwright runs so bursts of "Start run" clicks don't launch
# unbounded Chromium instances. Point this at your own Redis if you're not
# using docker-compose's.
REDIS_URL="redis://localhost:6381"

# How many runs execute (i.e. how many Chromium instances) at once. Extra
# runs wait in the queue until a slot frees up.
MAX_CONCURRENT_RUNS="2"

# Where to reach Ollama for Settings -> Ollama (connection check + model
# list) — see src/server/ollama.ts. Only used for local (non-Docker) dev;
# docker-compose.yml defaults to host.docker.internal instead, which Docker
# Desktop resolves to your host machine automatically.
OLLAMA_URL="http://localhost:11434"

# Vision-capable Ollama model the on-demand "Flow summary" agent
# (src/server/flowSummary.ts) uses to caption run screenshots and narrate
# the session. Must already be pulled (`ollama pull qwen2.5vl`) on the
# Ollama server above.
FLOW_SUMMARY_MODEL="qwen2.5vl:latest"

# Screenshots and trace.zip are stored in MinIO (S3-compatible), not on the
# local filesystem — see src/server/artifacts.ts. Only used for local
# (non-Docker) dev — docker-compose.yml sets its own MINIO_ENDPOINT (the
# "minio" service, port 9000 inside the compose network) and reuses
# MINIO_ROOT_USER/MINIO_ROOT_PASSWORD below as the access/secret key.
MINIO_ENDPOINT="localhost"
MINIO_PORT="9002"
MINIO_USE_SSL="false"
MINIO_BUCKET="skill-builder-artifacts"
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadmin-changeme"

# Credentials for the MinIO container itself (its root user, and — reused —
# the access/secret key the app authenticates with). Same CHANGEME story as
# SESSION_SECRET: public default, fine for a local try-it-out, replace
# before deploying anywhere reachable by others.
MINIO_ROOT_USER="minioadmin"
MINIO_ROOT_PASSWORD="minioadmin-changeme"

# Signs session JWTs — anyone who has this value can forge a login for any
# account. docker-compose.yml falls back to a public "insecure-dev-secret-
# changeme" default if this is unset, which is fine for a local try-it-out
# but not for anything reachable by anyone else. Generate a real one and
# never commit it: openssl rand -base64 32
SESSION_SECRET="REPLACE_ME"

# Encrypts stored global variable values. Same story as SESSION_SECRET —
# docker-compose.yml has a public insecure default; replace it before
# deploying anywhere reachable by others: openssl rand -base64 32
ENCRYPTION_KEY="REPLACE_ME"

# Run-lifecycle analytics events (created/started/completed/error) are
# written to ClickHouse — see src/server/analytics.ts. The run_events table
# is auto-created on first use; a ClickHouse outage never blocks or fails a
# run. Only used for local (non-Docker) dev — docker-compose.yml points
# CLICKHOUSE_URL at its own "clickhouse" service instead, but reuses
# CLICKHOUSE_USER/CLICKHOUSE_PASSWORD/CLICKHOUSE_DB below both to provision
# that container's user and to authenticate the app against it.
CLICKHOUSE_URL="http://localhost:8124"
CLICKHOUSE_USER="skillbuilder"
CLICKHOUSE_PASSWORD="clickhouse-changeme"
CLICKHOUSE_DATABASE="skillbuilder_analytics"
CLICKHOUSE_DB="skillbuilder_analytics"

# The per-skill action graph (crawled pages + possible actions, with vector
# embeddings for prompt-based retrieval) lives in Memgraph — see
# src/server/graphDb.ts / src/server/actionGraph.ts. Only used for local
# (non-Docker) dev — docker-compose.yml points this at its own "memgraph"
# service instead.
MEMGRAPH_URL="bolt://localhost:7688"

# Embedding model used to vector-search the action graph from a free-text
# prompt (src/server/embeddings.ts). Must already be pulled on the Ollama
# server above: ollama pull nomic-embed-text
EMBEDDING_MODEL="nomic-embed-text"
